# Copia este archivo a .env y reemplaza los valores REPLACE antes de iniciar.
# No guardes .env ni PINs reales en Git.
MESAPP_DB_USER=mesapp
MESAPP_DB_PASSWORD=REPLACE_WITH_PRIVATE_DATABASE_PASSWORD
MESAPP_RESTAURANT_NAME=Mi restaurante
MESAPP_RESTAURANT_ID=11111111-1111-4111-8111-111111111111
MESAPP_INSTALLATION_ID=22222222-2222-4222-8222-222222222222
MESAPP_INSTALLATION_NAME=Instalacion local
MESAPP_INITIAL_TABLES=23
MESAPP_BOOTSTRAP_ADMIN_NAME=Administrador
MESAPP_BOOTSTRAP_ADMIN_PIN=
MESAPP_PRINTER_TOKEN=REPLACE_WITH_PRIVATE_RANDOM_TOKEN
MESAPP_SYNC_TOKEN=REPLACE_WITH_PRIVATE_RANDOM_TOKEN
MESAPP_SYNC_TENANTS=
MESAPP_COOKIE_SECURE=false
MESAPP_FRONTEND_PORT=5173
MESAPP_BACKEND_PORT=8080

# Para producción, termina HTTPS/WSS en un proxy seguro y establece:
# MESAPP_COOKIE_SECURE=true
# MESAPP_ALLOWED_ORIGINS=https://mesapp.example.com
